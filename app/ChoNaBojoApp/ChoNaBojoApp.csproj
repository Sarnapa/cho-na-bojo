<Project Sdk="Microsoft.NET.Sdk">

	<!-- Local Google Maps API key, never committed — see AGENTS.md "Google Maps API key".
	     Must be imported before it is referenced ($(GoogleMapsApiKey) below), or CI's
	     -p:GoogleMapsApiKey=... override, which MSBuild also resolves before this file's own
	     property assignments run. -->
	<Import Project="$(MSBuildThisFileDirectory)..\..\secrets\maps.props" Condition="Exists('$(MSBuildThisFileDirectory)..\..\secrets\maps.props')" />

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ChoNaBojo.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Align Maui packages with UraniumUI 3.x requirement (>= 10.0.71) -->
		<MauiVersion>10.0.71</MauiVersion>

		<!-- Display name -->
		<ApplicationTitle>Cho Na Bojo</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.cho_na_bojo</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- S-02: Google Maps API key injected into the Android manifest placeholder at build
		     time. Value comes from the gitignored secrets/maps.props (local dev) or from
		     -p:GoogleMapsApiKey=... in CI (see .github/workflows/android-deploy.yml). -->
		<AndroidManifestPlaceholders Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">GOOGLE_MAPS_KEY=$(GoogleMapsApiKey)</AndroidManifestPlaceholders>
		<PackageIcon>appicon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="256,256" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- Unconditional across all TFMs: conditioning on Android breaks the Windows XAML
		     compile (MAUI003) because <maps:Map> is resolved at build time. Windows has a real
		     handler (Azure Maps-backed) that renders blank without a token — no crash. -->
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.100" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="UraniumUI.Icons.MaterialSymbols" Version="3.0.0" />
		<PackageReference Include="UraniumUI.Material" Version="3.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<GoogleServicesJson Include="Platforms\Android\google-services.json" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\shared\ChoNaBojo.Contracts\ChoNaBojo.Contracts.csproj" />
	  <ProjectReference Include="..\..\shared\ChoNaBojo.Validation\ChoNaBojo.Validation.csproj" />
	  <ProjectReference Include="..\..\shared\ChoNaBojo.Utils\ChoNaBojo.Utils.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Resources\AppIcon\appicon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<!-- Android release signing -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(AndroidSigningKeyStore)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>cho-na-bojo</AndroidSigningKeyAlias>
		<AndroidPackageFormats>aab</AndroidPackageFormats>
	</PropertyGroup>

	<!-- Default keystore path for local builds (overridden by CI) -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' == ''">
		<AndroidSigningKeyStore>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\secrets\cho-na-bojo.keystore'))</AndroidSigningKeyStore>
	</PropertyGroup>

	<!-- WindowsAppSDK issue #3337 workaround: honour RuntimeIdentifierOverride for Windows publish.
	     Use win-x64 (NOT win10-x64) — .NET 10 removed version-specific RIDs (NETSDK1083). -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
		<RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
	</PropertyGroup>

</Project>
